<?xml version="1.0" encoding="utf-8" ?>
<!--
  Web Profiles.tsx profile-avatar-button: circular gradient/mascot, name +
  status under it. Focus grows from the circle centre (not top-left) so the
  row of circles stays on one baseline.
-->
<component name="ProfileAvatar" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
    <field id="activeRailFactor" type="float" value="1" onChange="onFocusChanged" />
  </interface>
  <children>
    <!--
      Item box is 304×360 (MainScene buildProfileAvatarContent). The focused
      ring expands to about 303px, so 29px of transparent inset keeps its
      scaled edge inside the RowList item bounds. The RowList starts 23px
      higher to preserve the web-aligned avatar, label and action positions.
    -->
    <Group id="circleGroup" translation="[29,39]" scaleRotateCenter="[123,123]">
      <!-- Ring: 16px pad around 240 circle → 272; centre on circle. -->
      <Poster id="focusRing" translation="[-16,-16]" width="278" height="278" uri="pkg:/images/avatar-ring.png" opacity="0" loadDisplayMode="scaleToFit" />
      <Poster id="avatarImage" translation="[0,0]" width="246" height="246" loadDisplayMode="scaleToFit" />
      <!-- A custom photo: the account's JPEG, clipped to the circle by the mask (only the mask's alpha counts). -->
      <MaskGroup id="customMask" maskUri="pkg:/images/avatar-mask.png" maskSize="[246,246]" visible="false">
        <Poster id="customImage" translation="[0,0]" width="246" height="246" loadDisplayMode="scaleToZoom" />
      </MaskGroup>
      <Label id="initial" translation="[0,0]" width="246" height="246" horizAlign="center" vertAlign="center" scale="[2.2,2.2]" scaleRotateCenter="[123,123]" color="0xFFFFFFFF" visible="false" />
    </Group>
    <Label id="name" translation="[29,297]" width="246" height="34" horizAlign="center" numLines="1" scale="[0.55,0.55]" scaleRotateCenter="[123,17]" color="0xF4F0F1FF" />
    <Label id="status" translation="[29,329]" width="246" height="28" horizAlign="center" numLines="1" scale="[0.40,0.40]" scaleRotateCenter="[123,14]" color="0x887A82FF" />
  </children>
  <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/ProfileAvatar.brs" />
</component>
