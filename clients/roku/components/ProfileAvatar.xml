<?xml version="1.0" encoding="utf-8" ?>
<!--
  Web Profiles.tsx profile-avatar-button: circular gradient/mascot, name +
  status under it. Focus grows from the circle centre (not top-left) so the
  row of circles stays on one baseline.
-->
<component name="ProfileAvatar" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
    <field id="activeRailFactor" type="float" value="1" onChange="onFocusChanged" />
  </interface>
  <children>
    <!--
      Item box is 368×392 (MainScene buildProfileAvatarContent). The focused
      shadow expands to about 366px and the ring stays inside that box. The
      61px transparent inset keeps their centred transforms inside the
      RowList item bounds without changing the avatar centres.
    -->
    <!-- The web scales the whole profile button 1.045 and lifts it 8 px when focused, the circle a further 1.035. Item box is 368 x 392. -->
    <Group id="itemGroup" scaleRotateCenter="[184,203.8]">
      <!-- The profile button's hit box (avatar, name, status): the extent of the focused item, named for the profile. -->
      <Rectangle id="profileButton" translation="[62,53]" width="244" height="301.6" color="0x00000000" />
      <Group id="circleGroup" translation="[62,53]" scaleRotateCenter="[122,122]">
        <!-- The add profile's plus is text over its disc bitmap. -->
        <Poster id="focusShadow" translation="[-45,-15]" width="336" height="336" uri="pkg:/images/avatar-shadow.png" opacity="0" loadDisplayMode="scaleToFit" />
        <!-- Thin outline and the 20 px, 45% card glow, centred on the avatar. -->
        <Poster id="focusRing" translation="[-29,-29]" width="304" height="304" uri="pkg:/images/avatar-ring.png" opacity="0" loadDisplayMode="scaleToFit" />
        <Poster id="avatarImage" translation="[0,0]" width="244" height="244" loadDisplayMode="scaleToFit" />
        <!-- The preset mascot is its own picture inside the gradient circle (web: 225 px in a 264 px circle). -->
        <Poster id="avatarGlyph" translation="[17.95,17.95]" width="208.1" height="208.1" loadDisplayMode="scaleToFit" visible="false" />
        <!-- A custom photo: the account's JPEG, clipped to the circle by the mask (only the mask's alpha counts). -->
        <MaskGroup id="customMask" maskUri="pkg:/images/avatar-mask.png" maskSize="[244,244]" visible="false">
          <Poster id="customImage" translation="[0,0]" width="244" height="244" loadDisplayMode="scaleToZoom" />
        </MaskGroup>
        <WebLabel id="plusGlyph" translation="[99,69.4]" text="+" size="76.8" weight="300" visible="false" />
        <Label id="initial" translation="[0,0]" width="244" height="244" horizAlign="center" vertAlign="center" scale="[2.2,2.2]" scaleRotateCenter="[122,122]" color="0xFFFFFFFF" visible="false" />
      </Group>
      <Label id="name" translation="[62,298.8]" width="244" height="34" horizAlign="center" numLines="1" scale="[0.54,0.54]" scaleRotateCenter="[122,17]" color="0xF4F0F1FF" />
      <Label id="status" translation="[62,330.3]" width="244" height="28" horizAlign="center" numLines="1" scale="[0.2941,0.2941]" scaleRotateCenter="[122,14]" color="0x887A82FF" />
    </Group>
  </children>
  <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/ProfileAvatar.brs" />
</component>
