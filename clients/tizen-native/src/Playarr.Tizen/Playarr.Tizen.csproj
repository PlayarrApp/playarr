<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Samsung.NET.Sdk.Tizen workload; Tizen 10 matches the TV emulator and current TVs. -->
    <TargetFramework>net8.0-tizen10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Playarr.Tizen</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlayarrDebug)' == 'true'">
    <!-- Debug mirror and logging for the parity driver; never set in CI or release builds. -->
    <DefineConstants>$(DefineConstants);PLAYARR_DEBUG</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Playarr.Tizen.Logic/Playarr.Tizen.Logic.csproj" />
  </ItemGroup>
</Project>
