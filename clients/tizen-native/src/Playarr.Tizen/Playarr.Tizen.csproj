    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Playarr.Tizen</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Playarr.Tizen.Logic/Playarr.Tizen.Logic.csproj" />
  </ItemGroup>
</Project>
