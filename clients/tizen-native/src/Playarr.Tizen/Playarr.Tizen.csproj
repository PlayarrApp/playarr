<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Samsung.NET.Sdk.Tizen workload; Tizen 10 matches the TV emulator and current TVs. -->
