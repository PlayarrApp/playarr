<Page
    x:Class="Playarr.Xbox.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        Follows Views/LoginPage.xaml.cs's pattern (see that file's type-level
        remarks): every dynamic value is a named element pushed to from
        code-behind's Render(); no {x:Bind}, no {Binding}. Profile tiles are
        built in code (ProfilesPage.xaml.cs) since they come from a
        runtime-loaded list, not static XAML.
    -->
    <Grid x:Name="Root">
        <!-- Web TV profile picker: logo top left, "PROFILES" eyebrow, large title, 270 px avatar circles. -->
        <Image
            Source="ms-appx:///Assets/PlayarrIcon.png"
            Width="42"
            Height="42"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="60.6,60.2,0,0" />

        <StackPanel
            x:Name="ContentPanel"
            MaxWidth="1600"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,158,0,0"
            Spacing="0">

            <TextBlock
                x:Name="EyebrowText"
                Text="PROFILES"
                FontSize="10.37"
                LineHeight="14"
                LineStackingStrategy="BlockLineHeight"
                CharacterSpacing="120"
                Foreground="{StaticResource PlayarrBrandInk}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Who&#x2019;s watching?"
                x:Name="TitleText"
                FontSize="80.64"
                LineHeight="110"
                LineStackingStrategy="BlockLineHeight"
                CharacterSpacing="-40"
                HorizontalAlignment="Center"
                Margin="0,0,0,90" />

            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                HorizontalAlignment="Center"
                Width="48"
                Height="48" />

            <StackPanel
                x:Name="ErrorPanel"
                Spacing="12"
                HorizontalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}" />
                <Button
                    x:Name="RetryButton"
                    Content="Try again"
                    HorizontalAlignment="Center"
                    Click="RetryButton_Click" />
            </StackPanel>

            <ScrollViewer
                x:Name="ProfilesScrollViewer"
                HorizontalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Disabled">
                <StackPanel
                    x:Name="ProfilesPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="26" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
