<Page
    x:Class="Playarr.Xbox.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PlayarrSurface}">

    <!--
        Follows Views/LoginPage.xaml.cs's pattern, see LibraryPage.xaml.cs's
        type-level remarks. Kind tabs are built in code (server-defined,
        variable count, plus an "All" tab this page adds itself); the two
        sort buttons are static since there are only ever two. Grid tiles are
        built in code via CatalogTileFactory, same as HomePage's row, see
        that shared factory's remarks on why WorksGridView uses
        Items.Add(...) rather than ItemsSource + a bound ItemTemplate.
    -->
    <!--
        Web TV library page (1920x1080): Back and title at the shell content edge with the "N TITLES" subtitle, the
        focused title's details on the left, and a 3-column grid of 328x184 landscape cards from x=783.
    -->
    <Grid x:Name="Root">
        <local:FocusDetail x:Name="Detail" />

        <!-- Web A-Z jump rail at the right edge. -->
        <ScrollViewer
            x:Name="LetterRailScrollViewer"
            Width="40"
            Margin="0,270,21,65"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            VerticalScrollBarVisibility="Hidden"
            HorizontalScrollBarVisibility="Disabled"
            Padding="0">
            <Border x:Name="LetterRailContent" Padding="0,8,0,48">
                <StackPanel x:Name="LetterRail" Spacing="0" />
            </Border>
        </ScrollViewer>

        <ProgressRing
            x:Name="LoadingRing"
            IsActive="False"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="783,162,0,0"
            Width="40"
            Height="40" />

        <StackPanel
            x:Name="ErrorPanel"
            Spacing="12"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="783,162,0,0">
            <TextBlock x:Name="ErrorText" Style="{StaticResource PlayarrRailTitle}" />
            <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" />
        </StackPanel>

        <GridView
            x:Name="WorksGridView"
            Width="1128"
            Margin="735,0,0,0"
            Padding="48,162,0,48"
            HorizontalAlignment="Left"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            ItemClick="WorksGridView_ItemClick" />
    </Grid>
</Page>
