<Page
    x:Class="Playarr.Xbox.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        Follows Views/LoginPage.xaml.cs's established pattern: every dynamic
        value is a plain x:Name'd element pushed to from code-behind's
        Render(). The one addition this page needs beyond LoginPage's shape,
        a dynamic list of result tiles, is built directly into
        ResultsGrid.Items in code-behind rather than through an
        ItemsSource/DataTemplate, so it stays consistent with "no x:Bind,
        no Binding anywhere in this project" (see SearchPage.xaml.cs).
    -->
    <!-- Web TV search (1920x1080): header, 595x80 pill field, helper text, empty state centred in the right half. -->
    <Grid x:Name="Root">
        <Grid
            x:Name="SearchBox"
            Width="590"
            Height="76"
            Margin="153.59,172.78,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            CornerRadius="38"
            Background="{StaticResource PlayarrSurfaceStrong}"
            BorderBrush="{StaticResource PlayarrLineStrong}"
            BorderThickness="1">
            <Grid x:Name="SearchGlyph" AutomationProperties.LocalizedControlType="image" Width="24" Height="24" Margin="24,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PlayarrInkSoft}" />
            </Grid>
            <TextBox
                x:Name="QueryBox"
                Margin="61,0,21,0"
                Height="60"
                VerticalAlignment="Center"
                FontSize="18"
                Background="Transparent"
                BorderThickness="0"
                InputScope="Search"
                TextChanged="QueryBox_TextChanged"
                KeyUp="QueryBox_KeyUp" />
            <TextBlock
                x:Name="QueryHint"
                Text="Search your libraries and playlists"
                Margin="62,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                FontSize="18"
                Foreground="{StaticResource PlayarrInkMuted}" />
        </Grid>
        <TextBlock
            Text="Find any available movie, series, artist or playlist."
            Width="270"
            Margin="153.59,303.2,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="13.82"
            LineHeight="21.42"
            TextWrapping="WrapWholeWords"
            Foreground="{StaticResource PlayarrInkMuted}" />
        <ProgressRing x:Name="SearchingRing" IsActive="False" Width="32" Height="32" Margin="783,162,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBlock
            x:Name="ErrorText"
            Margin="783,162,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource PlayarrRailTitle}"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="EmptyStatePanel"
            Orientation="Horizontal"
            Spacing="42"
            Margin="1124.59,311.78,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Border Width="132" Height="132" CornerRadius="66" Background="{StaticResource PlayarrSurfaceStrong}">
                <Grid x:Name="EmptyGlyph" AutomationProperties.LocalizedControlType="image" Width="54" Height="36">
                    <FontIcon Glyph="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PlayarrBrand}" />
                </Grid>
            </Border>
            <TextBlock x:Name="EmptyStateText" Text="Start typing to search." FontSize="16.9" VerticalAlignment="Center" />
        </StackPanel>

        <local:LinkGridView
            x:Name="ResultsGrid"
            Width="1128"
            Margin="735,0,0,0"
            Padding="48,162,0,48"
            HorizontalAlignment="Left"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            ItemClick="ResultsGrid_ItemClick" />
    </Grid>
</Page>
