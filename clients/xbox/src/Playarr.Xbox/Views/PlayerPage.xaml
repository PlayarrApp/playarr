<Page
    x:Class="Playarr.Xbox.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <!--
        Follows Views/LoginPage.xaml.cs's pattern (see that file's type-level
        remarks) with one necessary deviation, explained in
        PlayerPage.xaml.cs and PlayerViewModel.cs's own remarks: the
        ViewModel needs the navigation parameter (the media-file id), which
        UWP only hands a page in OnNavigatedTo, not its constructor, so
        unlike every other page here, this one builds its ViewModel in
        OnNavigatedTo. Still no {x:Bind}, no {Binding}, no IValueConverter,
        Render() pushes plain values onto these named elements exactly like
        every other screen.
    -->
    <Grid>
        <MediaPlayerElement
            x:Name="PlayerElement"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
           
            AreTransportControlsEnabled="False" />

        <!-- Keyboard focus rests here until a key reveals the controls (web: focus sits on the video). -->
        <Button
            x:Name="VideoSurface"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            UseSystemFocusVisuals="False"
            FocusVisualPrimaryThickness="0"
            FocusVisualSecondaryThickness="0"
           
            AutomationProperties.Name="Video playback surface"
            Click="VideoSurface_Click" />


        <!-- Audio/subtitle track picker, toggled by TracksButton. -->
        <Grid
            x:Name="TracksPanel"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="420"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Opacity="0.95">
            <StackPanel Margin="24" Spacing="16">
                <TextBlock Text="Audio" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListBox x:Name="AudioTrackList" SelectionChanged="AudioTrackList_SelectionChanged" />
                <TextBlock Text="Subtitles" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListBox x:Name="SubtitleTrackList" SelectionChanged="SubtitleTrackList_SelectionChanged" />
            </StackPanel>
        </Grid>

        <!-- Playback info and queue panels, toggled by the info and queue controls. -->
        <Grid x:Name="InfoPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="420"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.95">
            <StackPanel Margin="24" Spacing="12">
                <TextBlock Text="Playback info" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="InfoText" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Grid x:Name="QueuePanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="420"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.95">
            <StackPanel Margin="24" Spacing="12">
                <TextBlock Text="Up next" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="QueueText" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--
            Web player chrome (owner rules): Close at the top right; a full-width scrubber over a bottom scrim; the large
            play/pause, the time and the track, queue, quality, info and device controls below it. Hides after 5 s without
            input; any key or pointer move shows it again. BACK closes an open panel, then the controls, then exits. Focus
            starts on the video surface; the first arrow key reveals the controls on play/pause and moves from there.
        -->
        <Grid x:Name="ChromePanel">
            <!-- Web .player-scrim: 48% of the height, black at 0.92 at the bottom edge; rises in and recedes downward. -->
            <Rectangle x:Name="Scrim" Height="518.39" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ScrimMove" />
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#EB000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Button
                x:Name="CloseButton"
                Width="48"
                Height="48"
                Margin="0,37.8,58,0"
                Padding="0"
                CornerRadius="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#9E0C0A0B"
                BorderBrush="#47FFFFFF"
                BorderThickness="1"
                FocusVisualPrimaryBrush="White"
                FocusVisualPrimaryThickness="3"
                FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Close player"
                Click="BackButton_Click">
                <Grid Width="14" Height="22"><FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
            <Slider
                x:Name="Scrubber"
                Height="44"
                Margin="70,0,70,122"
                VerticalAlignment="Bottom"
                Minimum="0"
                Maximum="1"
                StepFrequency="1"
                SmallChange="10"
                LargeChange="10"
                IsThumbToolTipEnabled="False"
                Foreground="{StaticResource PlayarrBrand}"
                Background="Transparent"
                FocusVisualPrimaryBrush="White"
                FocusVisualPrimaryThickness="2"
                FocusVisualSecondaryThickness="0"
               
                AutomationProperties.Name="Seek"
                ValueChanged="Scrubber_ValueChanged">
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Grid x:Name="HorizontalTemplate" Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="6" VerticalAlignment="Center" Fill="#4DFFFFFF" />
                                <Rectangle x:Name="HorizontalDecreaseRect" Grid.Column="0" Height="6" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
                                <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="1" Height="44" Background="Transparent" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>
            <Button x:Name="PrevButton" Width="64" Height="64" Margin="70,958,0,0" Padding="0" CornerRadius="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Previous episode" Click="PrevButton_Click" IsEnabled="False" Opacity="0.28">
                <Grid Width="20" Height="20"><FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button x:Name="PlayPauseButton" Width="64" Height="64" Margin="147.59,958,0,0" Padding="0" CornerRadius="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#24FFFFFF" BorderThickness="0" FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Play" Click="PlayPauseButton_Click">
                <Grid Width="20" Height="20"><FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button x:Name="NextButton" Width="64" Height="64" Margin="225.19,958,0,0" Padding="0" CornerRadius="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Next episode" Click="NextButton_Click" IsEnabled="False" Opacity="0.28">
                <Grid Width="20" Height="20"><FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
            <TextBlock x:Name="TimeText" Margin="302.78,981.84,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Foreground="White" />
            <Button x:Name="AudioButton" Width="64" Height="64" Margin="1301.58,958,0,0" Padding="0" CornerRadius="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Audio: Unavailable" Click="TracksButton_Click" IsEnabled="False" Opacity="0.28">
                <Grid Width="20" Height="20"><FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button x:Name="SubtitlesButton" Width="64" Height="64" Margin="1379.17,958,0,0" Padding="0" CornerRadius="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Subtitles: Off" Click="TracksButton_Click">
                <Grid Width="20" Height="20"><FontIcon Glyph="&#xE7F0;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button x:Name="QueueButton" Width="64" Height="64" Margin="1456.77,958,0,0" Padding="0" CornerRadius="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Playlist" Click="QueueButton_Click">
                <Grid Width="20" Height="20"><FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button x:Name="QualityButton" Height="56" Margin="1534.36,962,0,0" Padding="22.19,0,14.38,0" CornerRadius="28" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Quality" Click="InfoButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HD" FontSize="7.68" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,-2.4,0,0" />
                    <TextBlock x:Name="QualityText" Margin="16.59,-2.4,0,0" FontSize="10.56" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="InfoButton" Width="64" Height="64" Margin="1708.41,958,0,0" Padding="0" CornerRadius="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Info and playback health" Click="InfoButton_Click">
                <Grid Width="20" Height="20"><FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
            <!-- Web "Play on another device": the console is not a handoff target, so the control says so. -->
            <Button x:Name="DeviceButton" Width="64" Height="64" Margin="1786,958,0,0" Padding="0" CornerRadius="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Play on another device">
                <Grid Width="20" Height="20"><FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                <Button.Flyout>
                    <Flyout>
                        <TextBlock Text="No other devices available" FontSize="14" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--
            End-of-playback screen (docs/architecture/end-of-playback.md): shown over
            the finished video. UpNext phase shows a countdown with Play now /
            Cancel / Exit; EndCard phase shows Replay / Exit (and Play next when a
            queued item remains). Suggestions come from /catalog/{id}/similar.
            Plain Buttons so the gamepad's XY focus navigation reaches them.
        -->
        <Grid x:Name="EndPanel" Visibility="Collapsed" Background="#E6000000" AutomationProperties.LandmarkType="Custom" AutomationProperties.LocalizedLandmarkType="dialog">
            <StackPanel VerticalAlignment="Center" Margin="64,0" Spacing="20">
                <TextBlock
                    x:Name="EndHeadingText"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Foreground="White" />
                <TextBlock
                    x:Name="EndDetailText"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="White"
                    Opacity="0.85"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="16" XYFocusKeyboardNavigation="Enabled">
                    <Button x:Name="PlayNextButton" Content="Play now" Click="PlayNextButton_Click" />
                    <Button x:Name="CancelCountdownButton" Content="Cancel" Click="CancelCountdownButton_Click" />
                    <Button x:Name="ReplayButton" Content="Replay" Click="ReplayButton_Click" />
                    <Button x:Name="ExitButton" Content="Back to details" Click="ExitButton_Click" />
                </StackPanel>
                <TextBlock
                    x:Name="SuggestionsHeading"
                    Text="More like this"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="White"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="SuggestionsList"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="SuggestionsList_ItemClick"
                    Visibility="Collapsed"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    Height="340">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </StackPanel>
        </Grid>

        <!-- Small buffering spinner over the black stage while PlayerViewModel.LoadState is Loading. No text, no interstitial. -->
        <ProgressRing
            x:Name="LoadingPanel"
            IsActive="True"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- Error overlay, visible while PlayerViewModel.LoadState is Failed. -->
        <StackPanel
            x:Name="ErrorPanel"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="720"
            Spacing="24">
            <TextBlock
                x:Name="ErrorText"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Foreground="White"
                TextWrapping="Wrap"
                HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" />
                <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
