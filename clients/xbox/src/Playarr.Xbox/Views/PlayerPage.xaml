<Page
    x:Class="Playarr.Xbox.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <!--
        Follows Views/LoginPage.xaml.cs's pattern (see that file's type-level
        remarks) with one necessary deviation, explained in
        PlayerPage.xaml.cs and PlayerViewModel.cs's own remarks: the
        ViewModel needs the navigation parameter (the media-file id), which
        UWP only hands a page in OnNavigatedTo, not its constructor, so
        unlike every other page here, this one builds its ViewModel in
        OnNavigatedTo. Still no {x:Bind}, no {Binding}, no IValueConverter,
        Render() pushes plain values onto these named elements exactly like
        every other screen.
    -->
    <Grid>
        <MediaPlayerElement
            x:Name="PlayerElement"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AreTransportControlsEnabled="False" />


        <!-- Audio/subtitle track picker, toggled by TracksButton. -->
        <Grid
            x:Name="TracksPanel"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="420"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Opacity="0.95">
            <StackPanel Margin="24" Spacing="16">
                <TextBlock Text="Audio" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListBox x:Name="AudioTrackList" SelectionChanged="AudioTrackList_SelectionChanged" />
                <TextBlock Text="Subtitles" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListBox x:Name="SubtitleTrackList" SelectionChanged="SubtitleTrackList_SelectionChanged" />
            </StackPanel>
        </Grid>

        <!-- Playback info and queue panels, toggled by the info and queue controls. -->
        <Grid x:Name="InfoPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="420"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.95">
            <StackPanel Margin="24" Spacing="12">
                <TextBlock Text="Playback info" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="InfoText" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Grid x:Name="QueuePanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="420"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.95">
            <StackPanel Margin="24" Spacing="12">
                <TextBlock Text="Up next" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="QueueText" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--
            Web player chrome (owner rules): Close at the top right; a full-width scrubber over a bottom scrim; the large
            play/pause, the time and the audio/subtitles control below it. Hides after 5 s without input; any key or
            pointer move shows it again. BACK closes an open panel, then the controls, then exits.
        -->
        <Grid x:Name="ChromePanel">
            <!-- Web .player-scrim: 48% of the height, black at 0.92 at the bottom edge; rises in and recedes downward. -->
            <Rectangle x:Name="Scrim" Height="518" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ScrimMove" />
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#EB000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Button
                x:Name="CloseButton"
                Width="48"
                Height="48"
                Margin="0,38,58,0"
                Padding="0"
                CornerRadius="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#33000000"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                FocusVisualPrimaryBrush="White"
                FocusVisualPrimaryThickness="3"
                FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Close"
                Click="BackButton_Click">
                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" />
            </Button>
            <Slider
                x:Name="Scrubber"
                Margin="70,0,70,132"
                VerticalAlignment="Bottom"
                Minimum="0"
                Maximum="1"
                StepFrequency="1"
                SmallChange="10"
                LargeChange="10"
                IsThumbToolTipEnabled="False"
                Foreground="{StaticResource PlayarrBrand}"
                Background="#4DFFFFFF"
                FocusVisualPrimaryBrush="White"
                FocusVisualPrimaryThickness="2"
                FocusVisualSecondaryThickness="0"
                AutomationProperties.Name="Seek"
                ValueChanged="Scrubber_ValueChanged" />
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="80,0,0,56" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Button x:Name="PrevButton" Width="44" Height="44" Padding="0" CornerRadius="22" Background="Transparent" BorderThickness="0"
                    FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                    AutomationProperties.Name="Previous" Click="PrevButton_Click" IsEnabled="False" Opacity="0.35">
                    <FontIcon Glyph="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                </Button>
                <Button
                    x:Name="PlayPauseButton"
                    Width="72"
                    Height="72"
                    Padding="0"
                    CornerRadius="36"
                    Background="#33000000"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    FocusVisualPrimaryBrush="White"
                    FocusVisualPrimaryThickness="3"
                    FocusVisualSecondaryThickness="0"
                    AutomationProperties.Name="Play or pause"
                    Click="PlayPauseButton_Click">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" />
                </Button>
                <Button x:Name="NextButton" Width="44" Height="44" Padding="0" CornerRadius="22" Background="Transparent" BorderThickness="0"
                    FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                    AutomationProperties.Name="Next" Click="NextButton_Click" IsEnabled="False" Opacity="0.35">
                    <FontIcon Glyph="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                </Button>
                <TextBlock x:Name="TimeText" Margin="3,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="33" Margin="0,0,80,70" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="VolumeButton" Width="44" Height="44" Padding="0" CornerRadius="22" Background="Transparent" BorderThickness="0"
                    FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                    AutomationProperties.Name="Volume" Click="VolumeButton_Click" >
                    <FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                </Button>
                <Button x:Name="TracksButton" Width="44" Height="44" Padding="0" CornerRadius="22" Background="Transparent" BorderThickness="0"
                    FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                    AutomationProperties.Name="Audio and subtitles" Click="TracksButton_Click" >
                    <FontIcon Glyph="&#xE7F0;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                </Button>
                <Button x:Name="QueueButton" Width="44" Height="44" Padding="0" CornerRadius="22" Background="Transparent" BorderThickness="0"
                    FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                    AutomationProperties.Name="Queue" Click="QueueButton_Click" >
                    <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="9,0,22,0">
                    <Border BorderBrush="#99FFFFFF" BorderThickness="1" CornerRadius="3" Padding="3,0,3,0" VerticalAlignment="Center">
                        <TextBlock Text="HD" FontSize="8" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <TextBlock x:Name="QualityText" FontSize="10.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="InfoButton" Width="44" Height="44" Padding="0" CornerRadius="22" Background="Transparent" BorderThickness="0"
                    FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                    AutomationProperties.Name="Playback info" Click="InfoButton_Click" >
                    <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                </Button>
                <!-- Web "Play on another device": the console is not a handoff target, so the control says so. -->
                <Button x:Name="DeviceButton" Width="44" Height="44" Padding="0" CornerRadius="22" Background="Transparent" BorderThickness="0"
                    FocusVisualPrimaryBrush="White" FocusVisualPrimaryThickness="3" FocusVisualSecondaryThickness="0"
                    AutomationProperties.Name="Play on another device">
                    <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                    <Button.Flyout>
                        <Flyout>
                            <TextBlock Text="No other devices available" FontSize="14" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!--
            End-of-playback screen (docs/architecture/end-of-playback.md): shown over
            the finished video. UpNext phase shows a countdown with Play now /
            Cancel / Exit; EndCard phase shows Replay / Exit (and Play next when a
            queued item remains). Suggestions come from /catalog/{id}/similar.
            Plain Buttons so the gamepad's XY focus navigation reaches them.
        -->
        <Grid x:Name="EndPanel" Visibility="Collapsed" Background="#E6000000" AutomationProperties.LandmarkType="Custom" AutomationProperties.LocalizedLandmarkType="dialog">
            <StackPanel VerticalAlignment="Center" Margin="64,0" Spacing="20">
                <TextBlock
                    x:Name="EndHeadingText"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Foreground="White" />
                <TextBlock
                    x:Name="EndDetailText"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="White"
                    Opacity="0.85"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="16" XYFocusKeyboardNavigation="Enabled">
                    <Button x:Name="PlayNextButton" Content="Play now" Click="PlayNextButton_Click" />
                    <Button x:Name="CancelCountdownButton" Content="Cancel" Click="CancelCountdownButton_Click" />
                    <Button x:Name="ReplayButton" Content="Replay" Click="ReplayButton_Click" />
                    <Button x:Name="ExitButton" Content="Back to details" Click="ExitButton_Click" />
                </StackPanel>
                <TextBlock
                    x:Name="SuggestionsHeading"
                    Text="More like this"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="White"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="SuggestionsList"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="SuggestionsList_ItemClick"
                    Visibility="Collapsed"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    Height="340">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
            </StackPanel>
        </Grid>

        <!-- Small buffering spinner over the black stage while PlayerViewModel.LoadState is Loading. No text, no interstitial. -->
        <ProgressRing
            x:Name="LoadingPanel"
            IsActive="True"
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- Error overlay, visible while PlayerViewModel.LoadState is Failed. -->
        <StackPanel
            x:Name="ErrorPanel"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="720"
            Spacing="24">
            <TextBlock
                x:Name="ErrorText"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Foreground="White"
                TextWrapping="Wrap"
                HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" />
                <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
