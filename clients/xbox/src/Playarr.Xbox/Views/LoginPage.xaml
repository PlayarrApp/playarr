<Page
    x:Class="Playarr.Xbox.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        The reference screen every other page in this app should follow
        structurally. See LoginPage.xaml.cs's type-level remarks for the
        exact pattern — summarised here: every dynamic value on this page
        is a plain x:Name'd element pushed to from code-behind's Render();
        there is no {x:Bind} and no IValueConverter anywhere in this project.
    -->
    <!-- Web TV /login/qr (embedded DeviceLogin): kicker, heading, description, a 240 px QR tile, the code and the countdown. -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel
            x:Name="ContentPanel"
            Width="620"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,40"
            Spacing="0">

            <TextBlock Text="WELCOME HOME" FontSize="12" FontWeight="Bold" CharacterSpacing="120" Foreground="{StaticResource PlayarrBrandInk}" HorizontalAlignment="Center" />
            <TextBlock Text="Sign in to Playarr" Style="{StaticResource PlayarrPageTitle}" CharacterSpacing="0" FontSize="44" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock
                x:Name="DescriptionText"
                Text="Scan the QR code with your phone or another browser to sign in on this device."
                Foreground="{StaticResource PlayarrInkSoft}"
                FontSize="16"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords"
                Margin="0,14,0,0" />

            <!-- QR pairing: the code is requested as soon as the page opens, no address is typed. -->
            <StackPanel x:Name="PairingPanel" Spacing="20" Margin="0,32,0,0" HorizontalAlignment="Center">
                <Border
                    x:Name="QrHost"
                    Width="240"
                    Height="240"
                    CornerRadius="18"
                    Background="White"
                    HorizontalAlignment="Center" />
                <StackPanel x:Name="DeviceCodePanel" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Scan the QR code, or visit" Foreground="{StaticResource PlayarrInkSoft}" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock x:Name="VerificationUriText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="and enter this code" Foreground="{StaticResource PlayarrInkSoft}" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="UserCodeText"
                        FontSize="56"
                        FontWeight="Bold"
                        CharacterSpacing="140"
                        FontFamily="{StaticResource PlayarrMonoFont}"
                        HorizontalAlignment="Center" />
                    <TextBlock x:Name="PairingStatusText" Foreground="{StaticResource PlayarrInkSoft}" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="CountdownText"
                        Foreground="{StaticResource PlayarrInkSoft}"
                        FontSize="14"
                        FontWeight="Bold"
                        FontFamily="{StaticResource PlayarrMonoFont}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Manual fallback: only when the viewer asks for it. -->
            <StackPanel x:Name="ServerPanel" Spacing="12" Margin="0,32,0,0" Visibility="Collapsed">
                <TextBlock Text="Playarr server address" Style="{StaticResource BodyTextBlockStyle}" />
                <TextBox
                    x:Name="ServerAddressBox"
                    InputScope="Url"
                    PlaceholderText="http://your-server:8484" />
                <TextBlock
                    x:Name="ServerErrorText"
                    Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="ConnectButton"
                    Content="Connect"
                    HorizontalAlignment="Center"
                    Click="ConnectButton_Click" />
            </StackPanel>

            <TextBlock
                x:Name="FailureText"
                Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Visibility="Collapsed" />

            <Button
                x:Name="RetryButton"
                Content="Try again"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Visibility="Collapsed"
                Click="RetryButton_Click" />

            <Button
                x:Name="ModeButton"
                Content="Sign in manually"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Height="50"
                CornerRadius="25"
                Margin="0,28,0,0"
                Click="ModeButton_Click" />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
