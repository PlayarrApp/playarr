<Page
    x:Class="Playarr.Xbox.Views.WorkDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PlayarrSurface}">

    <!--
        Follows Views/LoginPage.xaml.cs's established pattern: every
        dynamic value is a plain x:Name'd element pushed to from
        code-behind's Render(). The season/episode lists are the one
        addition beyond LoginPage's shape, built directly into
        SeasonsPanel.Children / EpisodesPanel.Children in code-behind
        rather than through an ItemsSource/DataTemplate, matching
        SearchPage's identical judgment call for its result tiles.
    -->
    <!--
        Web TV title page (1920x1080): backdrop behind the left half under a dark scrim, Back plus the library name
        with the title as subtitle, then genre eyebrow, large title, meta row, synopsis and the action pills. Seasons and
        episodes sit in the right column from x=881, where the web shows its rails.
    -->
    <Grid>
        <Grid x:Name="BackdropLayer" Width="998.4" Height="1144.8" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
            </Grid.RenderTransform>
            <Image
                x:Name="BackdropImage"
                Stretch="UniformToFill"
                IsHitTestVisible="False" />
        </Grid>
        <Rectangle x:Name="BackdropImageMaskWash" Width="998.4" Height="1144.8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="BackdropFade" Width="960" HorizontalAlignment="Left" IsHitTestVisible="False" />
        <Rectangle x:Name="BackdropVerticalFade" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
        <Rectangle x:Name="BackdropStageWashRight" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
        <Rectangle x:Name="BackdropStageWashLeft" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />

        <Button
            x:Name="BackButton"
            Width="50"
            Height="50"
            CornerRadius="25"
            Margin="154,56,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="{StaticResource PlayarrLineStrong}"
            BorderThickness="1"
            Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
        </Button>
        <StackPanel x:Name="HeaderTitles" Margin="228,57,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock x:Name="LibraryText" Style="{StaticResource PlayarrPageTitle}" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="11"
                FontWeight="Bold"
                CharacterSpacing="120"
                Foreground="{StaticResource PlayarrBrandInk}"
                Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Width="700" Margin="154,258,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock
                x:Name="EyebrowText"
                FontSize="12"
                FontWeight="Bold"
                CharacterSpacing="120"
                Foreground="{StaticResource PlayarrBrandInk}" />
            <TextBlock
                x:Name="TitleText"
                FontSize="64"
                FontWeight="SemiBold"
                CharacterSpacing="-40"
                LineHeight="62"
                LineStackingStrategy="BlockLineHeight"
                MaxWidth="400"
                HorizontalAlignment="Left"
                TextWrapping="WrapWholeWords"
                MaxLines="3"
                Margin="0,34,0,0" />
            <TextBlock x:Name="EpisodeTitleText" FontSize="22" Foreground="{StaticResource PlayarrInkSoft}" Margin="0,12,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="MetaText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PlayarrInkSoft}" Margin="0,21,0,0" />
            <TextBlock
                x:Name="OverviewText"
                Width="330"
                HorizontalAlignment="Left"
                FontSize="12.5"
                LineHeight="20.5"
                TextWrapping="WrapWholeWords"
                MaxLines="5"
                TextTrimming="WordEllipsis"
                Foreground="{StaticResource PlayarrInkSoft}"
                Margin="0,24,0,0" />
            <StackPanel x:Name="PrimaryRow" Orientation="Horizontal" Spacing="17" Margin="0,32,0,0">
            <Button
                x:Name="PlayButton"
                MinWidth="160"
                Height="66"
                Padding="26,0,26,0"
                CornerRadius="33"
                Background="{StaticResource PlayarrInk}"
                BorderThickness="0"
                FocusVisualPrimaryBrush="{StaticResource PlayarrFocusRing}"
                FocusVisualPrimaryThickness="3"
                FocusVisualSecondaryThickness="0"
                Click="PrimaryPlay_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource PlayarrSurfaceStrong}" />
                    <TextBlock x:Name="PlayLabel" Text="Play" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PlayarrSurfaceStrong}" />
                </StackPanel>
            </Button>
            </StackPanel>

            <StackPanel x:Name="ActionRow" Orientation="Horizontal" Spacing="14" Margin="0,16,0,0" Visibility="Collapsed" />

            <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Left" Width="40" Height="40" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource PlayarrRailTitle}" Visibility="Collapsed" />
        </StackPanel>

        <!-- Series: one rail per season (web "Season N" + "N episodes" + episode thumbnails), from x=881. -->
        <ScrollViewer Margin="833,0,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="SeriesPanel" Margin="48,345,0,48" Spacing="0" Visibility="Collapsed" />
        </ScrollViewer>
    </Grid>
</Page>
