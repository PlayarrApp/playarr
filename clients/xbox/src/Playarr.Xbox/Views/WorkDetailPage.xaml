<Page
    x:Class="Playarr.Xbox.Views.WorkDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PlayarrSurface}">

    <!--
        Follows Views/LoginPage.xaml.cs's established pattern: every
        dynamic value is a plain x:Name'd element pushed to from
        code-behind's Render(). The season/episode lists are the one
        addition beyond LoginPage's shape, built directly into
        SeasonsPanel.Children / EpisodesPanel.Children in code-behind
        rather than through an ItemsSource/DataTemplate, matching
        SearchPage's identical judgment call for its result tiles.
    -->
    <!--
        Web TV title page (1920x1080): backdrop behind the left half under a dark scrim, Back plus the library name
        with the title as subtitle, then genre eyebrow, large title, meta row, synopsis and the action pills. Seasons and
        episodes sit in the right column from x=881, where the web shows its rails.
    -->
    <Grid x:Name="Root">
        <!-- The web's key-art box: laid out 899.97 x 1190.59 from (133.03, -22.9) and covered by the backdrop. -->
        <Grid x:Name="BackdropLayer" Width="899.97" Height="1190.59" Margin="133.03,-22.9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image
                x:Name="BackdropImage"
                Stretch="UniformToFill"
                IsHitTestVisible="False" />
        </Grid>
        <Rectangle x:Name="BackdropImageMaskWash" Width="899.97" Height="1190.59" Margin="133.03,-22.9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
        <Rectangle x:Name="BackdropFade" HorizontalAlignment="Stretch" IsHitTestVisible="False" />
        <Rectangle x:Name="BackdropVerticalFade" Width="998.4" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
        <Rectangle x:Name="BackdropStageWashLeft" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
        <Rectangle x:Name="BackdropRightWash" Width="1190.39" Margin="729.61,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />

        <StackPanel Width="700" Margin="154,260.19,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock x:Name="EyebrowText" FontSize="12.29" CharacterSpacing="100" Foreground="{StaticResource PlayarrBrandInk}" />
            <!-- One block per title line (see FocusDetail): the font's own line height, stacked 62.2 px apart. -->
            <StackPanel x:Name="TitleLines" Margin="0,11.33,0,0" />
            <TextBlock x:Name="EpisodeTitleText" FontSize="21.12" Foreground="{StaticResource PlayarrInkSoft}" Margin="0,1.64,0,0" Visibility="Collapsed" />
            <StackPanel x:Name="MetaRow" Orientation="Horizontal" Spacing="13.6" Margin="0,11.2,0,0" />
            <TextBlock
                x:Name="OverviewText"
                Width="328"
                HorizontalAlignment="Left"
                FontSize="12.86"
                LineHeight="20.31"
                LineStackingStrategy="BaselineToBaseline"
                TextWrapping="WrapWholeWords"
                MaxLines="5"
                TextTrimming="WordEllipsis"
                Foreground="{StaticResource PlayarrInkMuted}"
                Margin="0,23.44,0,0" />
            <StackPanel x:Name="PrimaryRow" Orientation="Horizontal" Spacing="16" Margin="0,16.49,0,0">
            <Button
                x:Name="PlayButton"
                MinWidth="156"
                Height="64"
                Padding="0"
                CornerRadius="32"
                Background="{StaticResource PlayarrInk}"
                BorderThickness="0"
                RenderTransformOrigin="0.5,0.5"
                FocusVisualPrimaryBrush="{StaticResource PlayarrFocusRing}"
                FocusVisualPrimaryThickness="3"
                FocusVisualSecondaryThickness="0"
                Click="PrimaryPlay_Click">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="PlayScale" ScaleX="1" ScaleY="1" />
                </Button.RenderTransform>
                <StackPanel Orientation="Horizontal" Spacing="8.8">
                    <TextBlock x:Name="PlayIcon" Text="&#x25B6;" FontSize="10.12" Foreground="{StaticResource PlayarrBg}" VerticalAlignment="Center" />
                    <TextBlock x:Name="PlayLabel" Text="Play" FontSize="11.9" FontWeight="Bold" Foreground="{StaticResource PlayarrBg}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            </StackPanel>

            <StackPanel x:Name="ActionRow" Orientation="Horizontal" Spacing="16" Margin="0,12,0,0" Visibility="Collapsed" />

            <ProgressRing x:Name="LoadingRing" IsActive="False" HorizontalAlignment="Left" Width="40" Height="40" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource PlayarrRailTitle}" Visibility="Collapsed" />
        </StackPanel>

        <!-- Series: one rail per season (web "Season N" + "N episodes" + episode thumbnails), from x=881. -->
        <ScrollViewer x:Name="RailsScroll" Margin="833,0,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="SeriesPanel" Margin="49,345,0,48" Spacing="0" Visibility="Collapsed" />
        </ScrollViewer>
    </Grid>
</Page>
