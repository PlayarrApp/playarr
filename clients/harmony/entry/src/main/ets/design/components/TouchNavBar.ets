    // web's selected tile is 42 wide at the same 46 vp pitch (left edges equal): the lit tile is drawn 42 wide inside the 44 slot
    Row() {
      Column() {
        Image(item.icon)
          .width(ICON_SIZE)
          .height(ICON_SIZE)
          .objectFit(ImageFit.Contain)
          .colorFilter(tintFilter(item.id === this.selectedId ? activeColors().bg : activeColors().inkMuted))
          .draggable(false)
          .focusable(false)
      }
      .width(TILE_WIDTH - 2)
      .height(TILE_HEIGHT)
      .justifyContent(FlexAlign.Center)
      .borderRadius(TILE_RADIUS)
      .backgroundColor(item.id === this.selectedId ? toResourceColor(activeColors().ink) : Color.Transparent)
    }
    .width(TILE_WIDTH)
    .height(TILE_HEIGHT)
    .justifyContent(FlexAlign.Start)
    .onClick(() => {
      navigateFromRail(item.id, this.selectedId);
    })
  }

