{
  "$comment": "Shared device parity suite (docs/parity/SUITE.md). Every platform runs the same screens, themes, D-pad checks and playback cases; web (clients/tv-web) is the source of truth and its run writes expected.json. Keys are D-pad names: up down left right select back, select:long for a long press, name*N repeats a key. keys start from the signed-in Home screen. Nav moves are anchored at the bottom of the nav rail (left, then down*12 clamps on the profile entry) because the top of the rail depends on the account. route is the web path the screen ends on (:id matches one path segment); match (optional) is the end-state pattern when it differs from route (the agenda is the calendar's default view, so its URL has no view parameter). Every screen has a D-pad path on web; the calendar views and the Filters panel are reached through the Filters panel (View toggle) and the library's right-hand Filters button.",
  "version": 1,
  "account": "Device Test profile, dark by default, signed in, Home",
  "themes": [
    "dark",
    "light"
  ],
  "screens": [
    {
      "id": "home",
      "route": "/",
      "keys": []
    },
    {
      "id": "movies",
      "route": "/movies",
      "keys": [
        "left",
        "down*12",
        "up*6",
        "select"
      ]
    },
    {
      "id": "series",
      "route": "/series",
      "keys": [
        "left",
        "down*12",
        "up*7",
        "select"
      ]
    },
    {
      "id": "music",
      "route": "/music",
      "keys": [
        "left",
        "down*12",
        "up*5",
        "select"
      ]
    },
    {
      "id": "calendar-month",
      "route": "/calendar?view=month",
      "keys": [
        "left",
        "down*12",
        "up*1",
        "select",
        "down",
        "select",
        "down",
        "select",
        "back"
      ]
    },
    {
      "id": "calendar-week",
      "route": "/calendar?view=week",
      "keys": [
        "left",
        "down*12",
        "up*1",
        "select",
        "down",
        "select",
        "down",
        "left",
        "select",
        "back"
      ]
    },
    {
      "id": "calendar-agenda",
      "route": "/calendar?view=agenda",
      "keys": [
        "left",
        "down*12",
        "up*1",
        "select"
      ],
      "match": "/calendar"
    },
    {
      "id": "search",
      "route": "/search",
      "keys": [
        "left",
        "down*12",
        "up*9",
        "select"
      ]
    },
    {
      "id": "film-detail",
      "route": "/movies/:id",
      "keys": [
        "left",
        "down*12",
        "up*6",
        "select",
        "right",
        "select"
      ],
      "open": "/movies/ca309574-c0f4-4564-bb54-4512eab7e531",
      "title": "2 Fast 2 Furious"
    },
    {
      "id": "series-detail",
      "route": "/series/:id",
      "keys": [
        "left",
        "down*12",
        "up*7",
        "select",
        "right",
        "select"
      ],
      "open": "/series/7ab4ce97-d59e-43d6-8e03-31d4d29a5c90",
      "title": "2 Broke Girls"
    },
    {
      "id": "settings",
      "route": "/settings",
      "keys": [
        "left",
        "down*12",
        "select",
        "down*2",
        "select"
      ]
    },
    {
      "id": "filters",
      "route": "/movies?panel=filters",
      "keys": [
        "left",
        "down*12",
        "up*6",
        "select",
        "right*12",
        "up",
        "select"
      ]
    },
    {
      "id": "profiles",
      "route": "/profiles",
      "keys": [
        "left",
        "down*12",
        "select"
      ]
    },
    {
      "id": "player-controls",
      "route": "/player/:id",
      "keys": [
        "left",
        "down*12",
        "up*6",
        "select",
        "right",
        "select",
        "select"
      ]
    },
    {
      "id": "actions",
      "route": "/movies",
      "keys": [
        "left",
        "down*12",
        "up*6",
        "select",
        "right",
        "select:long"
      ]
    }
  ],
  "crops": [
    { "id": "movies-deep", "from": "movies", "keys": ["down*60"] },
    { "id": "music-last", "from": "music", "keys": ["down*14", "right*2"] },
    { "id": "home-down1-mid", "from": "home", "keys": ["down"], "settle": 0 },
    { "id": "home-down1", "from": "home", "keys": ["down"] },
    { "id": "home-down2", "from": "home", "keys": ["down", "down"] },
    { "id": "home-down3", "from": "home", "keys": ["down", "down", "down"] },
    { "id": "home-up-again", "from": "home", "keys": ["down", "down", "down", "up", "up"] },
    { "id": "home-right-end", "from": "home", "keys": ["right*14"] },
    { "id": "filters-bottom", "from": "filters", "keys": ["down*14"] },
    { "id": "filters-language", "from": "filters", "keys": ["down*4", "select"] },
    { "id": "filters-list", "from": "filters", "keys": ["left", "select"] },
    { "id": "home-covers", "from": "home", "keys": [], "launchArgs": ["-com.playarr.playarr.tvos.homeCovers", "YES"] },
    { "id": "home-covers-down1", "from": "home", "keys": ["down"], "launchArgs": ["-com.playarr.playarr.tvos.homeCovers", "YES"] },
    { "id": "home-covers-right-end", "from": "home", "keys": ["right*14"], "launchArgs": ["-com.playarr.playarr.tvos.homeCovers", "YES"] }
  ],
  "dpad": [
    {
      "id": "home-right",
      "from": "home",
      "keys": [
        "right"
      ],
      "compare": "position",
      "start": {
        "rail": 0,
        "index": 0
      }
    },
    {
      "id": "home-down",
      "from": "home",
      "keys": [
        "down"
      ],
      "compare": "position",
      "start": {
        "rail": 0,
        "index": 0
      }
    },
    {
      "id": "home-down-right",
      "from": "home",
      "keys": [
        "down",
        "right"
      ],
      "compare": "position",
      "start": {
        "rail": 0,
        "index": 0
      }
    },
    {
      "id": "home-left-nav",
      "from": "home",
      "keys": [
        "left"
      ],
      "compare": "position",
      "start": {
        "rail": 0,
        "index": 0
      }
    },
    {
      "id": "nav-right-stage",
      "from": "home",
      "keys": [
        "left",
        "right"
      ],
      "compare": "position",
      "start": {
        "rail": 0,
        "index": 0
      }
    },
    {
      "id": "nav-down",
      "from": "home",
      "keys": [
        "left",
        "down*12",
        "up"
      ]
    },
    {
      "id": "movies-grid-right",
      "from": "movies",
      "keys": [
        "right",
        "right"
      ]
    },
    {
      "id": "movies-grid-down",
      "from": "movies",
      "keys": [
        "right",
        "down"
      ]
    },
    {
      "id": "movies-grid-left-nav",
      "from": "movies",
      "keys": [
        "right",
        "left"
      ]
    },
    {
      "id": "series-grid-down",
      "from": "series",
      "keys": [
        "right",
        "down"
      ]
    },
    {
      "id": "detail-back",
      "from": "film-detail",
      "keys": [
        "back"
      ]
    },
    {
      "id": "long-press-actions",
      "from": "movies",
      "keys": [
        "right",
        "select:long"
      ]
    },
    {
      "id": "player-initial-focus",
      "from": "player-controls",
      "keys": [],
      "wait": 6000
    },
    {
      "id": "player-right",
      "from": "player-controls",
      "keys": [
        "right"
      ],
      "wait": 6000
    },
    {
      "id": "player-right-3",
      "from": "player-controls",
      "keys": [
        "right*3"
      ],
      "wait": 6000
    },
    {
      "id": "player-right-end",
      "from": "player-controls",
      "keys": [
        "right*8"
      ],
      "wait": 6000
    },
    {
      "id": "player-left-edge",
      "from": "player-controls",
      "keys": [
        "left"
      ],
      "wait": 6000
    },
    {
      "id": "player-up-seek",
      "from": "player-controls",
      "keys": [
        "up"
      ],
      "wait": 6000
    },
    {
      "id": "player-up-down",
      "from": "player-controls",
      "keys": [
        "up",
        "down"
      ],
      "wait": 6000
    },
    {
      "id": "player-ok-toggle",
      "from": "player-controls",
      "keys": [
        "select"
      ],
      "wait": 6000
    },
    {
      "id": "player-back",
      "from": "player-controls",
      "keys": [
        "back"
      ],
      "wait": 2500,
      "observe": "state"
    },
    {
      "id": "player-back-back",
      "from": "player-controls",
      "keys": [
        "back",
        "back"
      ],
      "wait": 2500,
      "observe": "state"
    },
    {
      "id": "player-panel-open",
      "from": "player-controls",
      "keys": [
        "right*2",
        "select"
      ],
      "wait": 6000,
      "observe": "panel"
    },
    {
      "id": "player-panel-close",
      "from": "player-controls",
      "keys": [
        "right*2",
        "select",
        "back"
      ],
      "wait": 6000,
      "observe": "panel"
    }
  ],
  "downloadMedia": {
    "movie": {
      "title": "The Batman/Superman Movie: World's Finest",
      "work": "4ec39b80-28c3-4d83-9f83-f07872e5f4c0",
      "file": "f057244e-e512-4eda-a0e1-2c0a847357ef",
      "note": "smallest original file of any movie on the test server (about 0.5 GB)"
    },
    "episode": {
      "title": "Adventure Time: Side Quests",
      "work": "3289a2c5-592e-4ed0-943a-17d9033457ef",
      "file": "44adbf21-bce8-4fd8-904a-fbd61e5ca7ad",
      "season": 2,
      "episode": 3,
      "note": "smallest original file of any episode (about 65 MB)"
    }
  },
  "downloads": [
    {
      "id": "movie-download",
      "label": "start a movie download and see it complete",
      "action": "start",
      "media": "movie",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      }
    },
    {
      "id": "episode-download",
      "label": "start a TV episode download and see it complete",
      "action": "start",
      "media": "episode",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      }
    },
    {
      "id": "pause-resume",
      "label": "pause a download, then resume it to completion",
      "action": "pause-resume",
      "media": "movie",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      }
    },
    {
      "id": "cancel",
      "label": "cancel a download mid-way",
      "action": "cancel",
      "media": "movie",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      }
    },
    {
      "id": "delete",
      "label": "delete a completed download",
      "action": "delete",
      "media": "movie",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      }
    },
    {
      "id": "edit",
      "label": "edit keep-until and quality of a download",
      "action": "edit",
      "media": "movie",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      }
    },
    {
      "id": "offline-play",
      "label": "play the downloaded title with the network off (frames advance)",
      "action": "offline-play",
      "media": "movie",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      }
    },
    {
      "id": "notification",
      "label": "a system notification appears, updates its progress and ends as completed or paused",
      "action": "notification",
      "media": "movie",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      },
      "requires": "notifications"
    },
    {
      "id": "series-pause",
      "label": "pause a whole series from the grouped Downloads page",
      "action": "series-pause",
      "media": "episode",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      },
      "requires": "grouped-downloads"
    },
    {
      "id": "series-delete",
      "label": "delete a whole series from the grouped Downloads page",
      "action": "series-delete",
      "media": "episode",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      },
      "requires": "grouped-downloads"
    },
    {
      "id": "season-pause",
      "label": "pause a whole season from the grouped Downloads page",
      "action": "season-pause",
      "media": "episode",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      },
      "requires": "grouped-downloads"
    },
    {
      "id": "season-delete",
      "label": "delete a whole season from the grouped Downloads page",
      "action": "season-delete",
      "media": "episode",
      "expect": {
        "state": "ok",
        "withinSeconds": 300
      },
      "requires": "grouped-downloads"
    }
  ],
  "performance": [
    {
      "id": "a",
      "file": "f057244e-e512-4eda-a0e1-2c0a847357ef",
      "label": "direct-play H.264/AAC MP4 (the iOS capture jobs pin this case, so it must negotiate direct play)",
      "expect": {
        "state": "playing",
        "startWithinSeconds": 30,
        "advanceSeconds": 3
      },
      "nowPlaying": true
    },
    {
      "id": "b",
      "file": "feabc8ba-712f-4816-b7b0-a0bb58aa1e94",
      "label": "high-bitrate H.264 (about 15 Mbps) the server serves without a live re-encode",
      "expect": {
        "state": "playing",
        "startWithinSeconds": 15,
        "advanceSeconds": 3
      }
    },
    {
      "id": "c",
      "file": "b9a68b2c-8382-4c34-a6f0-c4dd58f55093",
      "label": "title served by the other server",
      "expect": {
        "state": "playing",
        "startWithinSeconds": 45,
        "advanceSeconds": 3
      },
      "setup": "needs the admin routing rule that prefers the other node for this library; web serves it through /media/proxy/ then"
    }
  ]
}
