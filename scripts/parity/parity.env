# Shared configuration of every parity capture (web refs and devices) against the static parity server.
# Plain KEY=VALUE, readable by sh (set -a; . parity.env) and by parity-config.mjs. Never put a secret here:
# the account password is PLAYARR_PARITY_STATIC_PASSWORD in ~/.secrets.
# The clock is not set here: parity-config.mjs reads it from screens.json (determinism.clock) and exports PARITY_CLOCK.
# Server: this host's LAN address, so real TVs and phones reach it. static-server.sh refuses to start if the host is not local.
PARITY_SERVER_HOST=192.168.1.220
PARITY_SERVER_PORT=18500
PARITY_SERVER_URL=http://192.168.1.220:18500
# Seeded account (the first of three profiles: parity, parity-kids, parity-guest, all with the same password).
PARITY_ACCOUNT_NAME=parity
# Loopback listeners of the static server: artwork files, and the one-off backend boot that applies migrations.
PARITY_ART_PORT=18495
PARITY_BUILD_PORT=18501
