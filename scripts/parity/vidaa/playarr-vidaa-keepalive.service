[Unit]
Description=Playarr VIDAA TV keepalive (one MQTT session, wedge detection, Playarr foreground)
After=network-online.target

[Service]
Type=simple
Environment=VIDAA_HOST=@VIDAA_HOST@
Environment=VIDAA_MIRROR_PORT=18742
Environment=PYTHONUNBUFFERED=1
Environment=PLAYARR_DATA_DIR=@DATA@
ExecStart=@DATA@/scratch/20261008-vidaa-remote/venv/bin/python @DATA@/scripts/vidaa/keepalive.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
