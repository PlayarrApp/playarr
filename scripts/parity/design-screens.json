{
  "$comment": "Design-report screen list (owner, 3 Nov 2026): every screen of SCREENS-ALL.md on every device, both themes. Additive to suite.json (the D-pad suite is untouched): suite.json keeps the 15 original ids and their key paths, this file adds the web route, fixture and state of every id, new ones included. Read it with suite-design.mjs; capture with capture-design.mjs. kind: shell = inside the app shell (signed in), outside = signed in but outside the shell (profiles, household), signedOut = fresh context with no session, player = media player. open: the pinned static-catalogue route (suite.json). resolve: the route is read from the first link under that prefix on a library page, so it follows the frozen fixture. steps: type (selector, value), click (selector or text), waitGone (text), wait (ms). A screen with absent is not captured; the manifest records the reason.",
  "version": 1,
  "devices": {
    "web-tv": { "viewport": [1920, 1080], "dpr": 1, "mobile": false, "keys": true, "note": "TV layout, TV user agent, D-pad (keyboard) navigation like the TV clients" },
    "web-tablet": { "viewport": [1280, 800], "dpr": 2, "mobile": false, "keys": true, "noFocusRing": true, "note": "tablet layout (same group as the android-tablet refs), 2560x1600 pixels" },
    "web-phone": { "viewport": [390, 844], "dpr": 3, "mobile": true, "keys": false, "noFocusRing": true, "note": "phone layout, mobile user agent, touch, 1170x2532 pixels" }
  },
  "themes": ["dark", "light"],
  "screens": [
    { "id": "home", "kind": "shell", "route": "/" },
    { "id": "movies", "kind": "shell", "route": "/movies" },
    { "id": "series", "kind": "shell", "route": "/series" },
    { "id": "music", "kind": "shell", "route": "/music" },
    { "id": "calendar-month", "kind": "shell", "route": "/calendar?view=month" },
    { "id": "calendar-week", "kind": "shell", "route": "/calendar?view=week" },
    { "id": "calendar-agenda", "kind": "shell", "route": "/calendar?view=agenda" },
    { "id": "search", "kind": "shell", "route": "/search" },
    { "id": "film-detail", "kind": "shell", "route": "/movies/:id", "open": "suite" },
    { "id": "series-detail", "kind": "shell", "route": "/series/:id", "open": "suite" },
    { "id": "settings", "kind": "shell", "route": "/settings" },
    { "id": "filters", "kind": "shell", "route": "/movies?panel=filters", "dialog": true },
    { "id": "profiles", "kind": "outside", "route": "/profiles", "steps": [{ "type": "waitGone", "text": "Loading profiles" }] },
    { "id": "player-controls", "kind": "player", "route": "/player/:mediaFileId", "controls": true },
    { "id": "actions", "kind": "shell", "route": "/movies", "dialog": true },

    { "id": "login", "kind": "signedOut", "route": "/login" },
    { "id": "login-qr", "kind": "signedOut", "route": "/login/qr" },
    { "id": "signup", "kind": "signedOut", "route": "/signup" },
    { "id": "link", "kind": "outside", "route": "/link" },
    { "id": "household", "kind": "outside", "route": "/household" },
    { "id": "downloads", "kind": "shell", "route": "/downloads" },
    { "id": "sites", "kind": "shell", "route": "/sites" },
    { "id": "music-detail", "kind": "shell", "route": "/music/:workId", "resolve": { "list": "/music", "prefix": "/music/" } },
    { "id": "episode-detail", "kind": "shell", "route": "/series/:workId", "absent": "The web app has no separate episode route: App.tsx routes /series/:workId (WorkDetailPage) and episodes are cards of the series-detail page. Same page as series-detail." },
    { "id": "search-results", "kind": "shell", "route": "/search", "steps": [{ "type": "type", "selector": "input[type=search], input[type=text]", "value": "the" }] },
    { "id": "watchlist", "kind": "shell", "route": "/watchlist" },
    { "id": "requests", "kind": "shell", "route": "/requests" },
    { "id": "playlists", "kind": "shell", "route": "/playlists" },
    { "id": "playlist-detail", "kind": "shell", "route": "/playlists?playlist=:playlistId", "note": "the playlist view of the web app is /playlists?playlist=<id> (the card link); /playlists/:workId is a title page of an item", "resolve": { "list": "/playlists", "prefix": "/playlists?playlist=" } },
    { "id": "folders", "kind": "shell", "route": "/folders" },
    { "id": "player", "kind": "player", "route": "/player/:mediaFileId", "controls": false },
    { "id": "settings-appearance", "kind": "shell", "route": "/settings/appearance" },
    { "id": "settings-profile-avatar", "kind": "shell", "route": "/settings/profile-avatar" },
    { "id": "settings-language", "kind": "shell", "route": "/settings/language" },
    { "id": "settings-player", "kind": "shell", "route": "/settings/player" },
    { "id": "settings-server", "kind": "shell", "route": "/settings/server" },
    { "id": "settings-profile-lock", "kind": "shell", "route": "/settings/profile-lock" },
    { "id": "settings-invite", "kind": "shell", "route": "/settings/invite" },
    { "id": "settings-request-latency", "kind": "shell", "route": "/settings/request-latency", "allowApi": ["^403 /api/v1/admin/"] },
    { "id": "settings-remote", "kind": "shell", "route": "/settings/remote" },
    { "id": "settings-your-data", "kind": "shell", "route": "/settings/your-data" },
    { "id": "settings-home", "kind": "shell", "route": "/settings/home" },
    { "id": "not-found", "kind": "shell", "route": "/does-not-exist" },

    { "id": "home--focus-second-rail", "kind": "shell", "route": "/", "keysOnly": true, "keys": ["down"], "reason": "no focus ring on touch" },
    { "id": "search--keyboard", "kind": "shell", "route": "/search", "absent": "The web Search page (pages/Search.tsx) uses a native input: the on-screen keyboard belongs to the operating system, not the app, so the page has no keyboard state of its own." },
    { "id": "profiles--add", "kind": "outside", "endsOnSignIn": true, "route": "/profiles", "steps": [{ "type": "waitGone", "text": "Loading profiles" }, { "type": "click", "selector": "#profile-add" }] }
  ],
  "aliases": {
    "movies--filters-open": "filters",
    "film-detail--actions-open": "actions",
    "player--controls": "player-controls"
  }
}
